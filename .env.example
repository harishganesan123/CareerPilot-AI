# CareerPilot AI — root environment reference
# Copy relevant values into backend/.env and frontend/.env as needed.
# Never commit a real .env file.

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/careerpilot

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI provider (backend only) ---
# Never put the key in frontend/.env or in any variable prefixed with VITE_.
# Create a key in Google AI Studio and paste it into backend/.env on your machine.
AI_PROVIDER=gemini
AI_API_KEY=
# Any Gemini model ID your key can access (check AI Studio); this default is configurable.
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARS=30000
AI_RATE_LIMIT_PER_MINUTE=10

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
