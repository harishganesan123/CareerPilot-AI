# CareerPilot AI — root environment reference
# Copy relevant values into backend/.env and frontend/.env as needed.
# Never commit a real .env file.

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/careerpilot

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI provider ---
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
