+++ b/frontend/tests/chatHistory.test.ts
@@ -0,0 +1,54 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import {
+  CHAT_HISTORY_MAX_TOTAL_CHARS,
+  CHAT_HISTORY_MAX_TURNS,
+  CHAT_HISTORY_TURN_MAX_CHARS,
+  buildHistory,
+} from '../src/lib/chatHistory.ts'
+import type { TranscriptMessage } from '../src/lib/chatHistory.ts'
+
+const msg = (id: number, role: 'user' | 'assistant', content: string, failed = false): TranscriptMessage => ({
+  id, role, content, ...(failed ? { failed } : {}),
+})
+
+test('keeps messages in order and does not add the current message', () => {
+  const h = buildHistory([msg(1, 'user', 'q1'), msg(2, 'assistant', 'a1')])
+  assert.deepEqual(h, [{ role: 'user', content: 'q1' }, { role: 'assistant', content: 'a1' }])
+})
+
+test('empty transcript gives empty history', () => {
+  assert.deepEqual(buildHistory([]), [])
+})
+
+test('excludes failed (unanswered) messages so the model never sees them', () => {
+  const h = buildHistory([msg(1, 'user', 'q1'), msg(2, 'assistant', 'a1'), msg(3, 'user', 'bad', true)])
+  assert.deepEqual(h.map((t) => t.content), ['q1', 'a1'])
+})
+
+test('caps the number of turns, keeping the most recent', () => {
+  const all = Array.from({ length: 30 }, (_, i) => msg(i, i % 2 ? 'assistant' : 'user', `m${i}`))
+  const h = buildHistory(all)
+  assert.equal(h.length, CHAT_HISTORY_MAX_TURNS)
+  assert.equal(h.at(-1)?.content, 'm29')
+  assert.equal(h[0].content, 'm10')
+})
+
+test('truncates a single oversized turn', () => {
+  const h = buildHistory([msg(1, 'assistant', 'x'.repeat(CHAT_HISTORY_TURN_MAX_CHARS + 500))])
+  assert.equal(h[0].content.length, CHAT_HISTORY_TURN_MAX_CHARS)
+})
+
+test('drops oldest turns until total size fits the limit', () => {
+  const big = 'y'.repeat(CHAT_HISTORY_TURN_MAX_CHARS - 10) // under the per-turn cap, so only total-size trimming applies
+  const all = Array.from({ length: 6 }, (_, i) => msg(i, i % 2 ? 'assistant' : 'user', big + i))
+  const h = buildHistory(all)
+  const total = h.reduce((s, t) => s + t.content.length, 0)
+  assert.ok(total <= CHAT_HISTORY_MAX_TOTAL_CHARS)
+  assert.ok(h.length < 6, 'some old turns were dropped')
+  assert.ok(h.at(-1)!.content.endsWith('5'), 'newest turn is kept')
+})
+
+test('skips blank messages (server rejects empty history content)', () => {
+  assert.deepEqual(buildHistory([msg(1, 'user', '   '), msg(2, 'user', 'ok')]).map((t) => t.content), ['ok'])
+})
diff --git a/frontend/tests/markdown.test.ts b/frontend/tests/markdown.test.ts
new file mode 100644
index 0000000..160afc3
--- /dev/null
+++ b/frontend/tests/markdown.test.ts
@@ -0,0 +1,66 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { parseBlocks, parseInline } from '../src/lib/markdown.ts'
+
+test('paragraphs split on blank lines', () => {
+  const b = parseBlocks('First para.\n\nSecond para.')
+  assert.deepEqual(b.map((x) => x.kind), ['paragraph', 'paragraph'])
+})
+
+test('fenced code keeps content verbatim, including HTML, as data', () => {
+  const b = parseBlocks('Look:\n```python\nprint("<script>alert(1)</script>")\n```\nDone')
+  const code = b.find((x) => x.kind === 'code')
+  assert.ok(code && code.kind === 'code')
+  assert.equal(code.lang, 'python')
+  assert.equal(code.code, 'print("<script>alert(1)</script>")')
+  assert.deepEqual(b.map((x) => x.kind), ['paragraph', 'code', 'paragraph'])
+})
+
+test('unterminated fence consumes the rest as code instead of breaking', () => {
+  const b = parseBlocks('```js\nlet a = 1')
+  assert.deepEqual(b, [{ kind: 'code', lang: 'js', code: 'let a = 1' }])
+})
+
+test('bullet and ordered lists', () => {
+  const b = parseBlocks('- one\n- two\n\n1. first\n2. second')
+  assert.deepEqual(b, [
+    { kind: 'list', ordered: false, items: ['one', 'two'] },
+    { kind: 'list', ordered: true, items: ['first', 'second'] },
+  ])
+})
+
+test('switching list type without a blank line starts a new list', () => {
+  const b = parseBlocks('- a\n1. b')
+  assert.deepEqual(b.map((x) => x.kind === 'list' && x.ordered), [false, true])
+})
+
+test('indented continuation joins the previous list item', () => {
+  const b = parseBlocks('- item one\n  continues here')
+  assert.deepEqual(b, [{ kind: 'list', ordered: false, items: ['item one continues here'] }])
+})
+
+test('headings become heading blocks', () => {
+  assert.deepEqual(parseBlocks('## Title\ntext'), [
+    { kind: 'heading', text: 'Title' },
+    { kind: 'paragraph', text: 'text' },
+  ])
+})
+
+test('CRLF input is handled', () => {
+  assert.equal(parseBlocks('a\r\n\r\nb').length, 2)
+})
+
+test('inline code and bold are parsed; raw HTML stays plain text', () => {
+  const n = parseInline('Use `len()` and **care** with <b>html</b>')
+  assert.deepEqual(n.map((x) => x.kind), ['text', 'code', 'text', 'bold', 'text'])
+  assert.equal(n.at(-1)?.text, ' with <b>html</b>')
+  assert.equal(n.at(-1)?.kind, 'text')
+})
+
+test('unbalanced markers are left as text', () => {
+  assert.deepEqual(parseInline('a ** b ` c'), [{ kind: 'text', text: 'a ** b ` c' }])
+})
+
+test('empty input yields no blocks', () => {
+  assert.deepEqual(parseBlocks(''), [])
+})
